@base <http://example.org/ontology/semantic_scholar#> .

<http://example.org/ontology/semantic_scholar> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/ontology/semantic_scholar/allAuthors
ns1:allAuthors rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/ontology/semantic_scholar#coAuthorWithCommonInterest
:coAuthorWithCommonInterest rdf:type owl:ObjectProperty .


###  http://example.org/ontology/semantic_scholar/aPourInteret
ns1:aPourInteret rdf:type owl:ObjectProperty ;
                 rdfs:domain ns1:Auteur ;
                 rdfs:range ns1:Interet .


###  http://example.org/ontology/semantic_scholar/affilieA
ns1:affilieA rdf:type owl:ObjectProperty ;
             rdfs:domain ns1:Auteur ;
             rdfs:range ns1:Affiliation .


###  http://example.org/ontology/semantic_scholar/publieDans
ns1:publieDans rdf:type owl:ObjectProperty ;
               rdfs:domain ns1:Article ;
               rdfs:range ns1:Publication .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:ObjectProperty ;
           rdfs:domain ns1:Article ;
           rdfs:range ns1:Auteur .


#################################################################
#    Data properties
#################################################################

###  http://example.org/ontology/semantic_scholar#hasInfluence
:hasInfluence rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/affiliationId
ns1:affiliationId rdf:type owl:DatatypeProperty ;
                  rdfs:domain ns1:Affiliation ;
                  rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/affiliationLocalisation
ns1:affiliationLocalisation rdf:type owl:DatatypeProperty ;
                            rdfs:domain ns1:Affiliation ;
                            rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/affiliationNom
ns1:affiliationNom rdf:type owl:DatatypeProperty ;
                   rdfs:domain ns1:Affiliation ;
                   rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/articleLien
ns1:articleLien rdf:type owl:DatatypeProperty ;
                rdfs:domain ns1:Article ;
                rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/articleNbCitation
ns1:articleNbCitation rdf:type owl:DatatypeProperty ;
                      rdfs:domain ns1:Article ;
                      rdfs:range xsd:integer .


###  http://example.org/ontology/semantic_scholar/auteurHIndex
ns1:auteurHIndex rdf:type owl:DatatypeProperty ;
                 rdfs:domain ns1:Auteur ;
                 rdfs:range xsd:integer .


###  http://example.org/ontology/semantic_scholar/auteurId
ns1:auteurId rdf:type owl:DatatypeProperty ;
             rdfs:domain ns1:Auteur ;
             rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/interetId
ns1:interetId rdf:type owl:DatatypeProperty ;
              rdfs:domain ns1:Interet ;
              rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/interetNom
ns1:interetNom rdf:type owl:DatatypeProperty ;
               rdfs:domain ns1:Interet ;
               rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/publicationChapterPage
ns1:publicationChapterPage rdf:type owl:DatatypeProperty ;
                           rdfs:domain ns1:Publication ;
                           rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/publicationDate
ns1:publicationDate rdf:type owl:DatatypeProperty ;
                    rdfs:domain ns1:Publication ;
                    rdfs:range xsd:gYear .


###  http://example.org/ontology/semantic_scholar/publicationId
ns1:publicationId rdf:type owl:DatatypeProperty ;
                  rdfs:domain ns1:Publication ;
                  rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/publicationNom
ns1:publicationNom rdf:type owl:DatatypeProperty ;
                   rdfs:domain ns1:Publication ;
                   rdfs:range xsd:string .


###  http://example.org/ontology/semantic_scholar/publicationType
ns1:publicationType rdf:type owl:DatatypeProperty ;
                    rdfs:domain ns1:Publication ;
                    rdfs:range xsd:string .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:DatatypeProperty ;
        rdfs:domain ns1:Article ;
        rdfs:range xsd:gYear .


###  http://purl.org/dc/elements/1.1/identifier
dc:identifier rdf:type owl:DatatypeProperty ;
              rdfs:domain ns1:Article ;
              rdfs:range xsd:string .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:DatatypeProperty ;
         rdfs:domain ns1:Article ;
         rdfs:range xsd:string .


###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox rdf:type owl:DatatypeProperty ;
          rdfs:domain ns1:Auteur ;
          rdfs:range xsd:string .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:DatatypeProperty ;
          rdfs:domain ns1:Auteur ;
          rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://example.org/ontology/semantic_scholar/Affiliation
ns1:Affiliation rdf:type owl:Class .


###  http://example.org/ontology/semantic_scholar/Article
ns1:Article rdf:type owl:Class .


###  http://example.org/ontology/semantic_scholar/Auteur
ns1:Auteur rdf:type owl:Class .


###  http://example.org/ontology/semantic_scholar/Interet
ns1:Interet rdf:type owl:Class .


###  http://example.org/ontology/semantic_scholar/Publication
ns1:Publication rdf:type owl:Class .


